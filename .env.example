# Copy to .env.local (local) or add in Vercel > Project > Settings > Environment Variables.
# Never commit real values.

# Your n8n instance, no trailing slash, e.g. https://n8n.example.com
N8N_BASE_URL=
# n8n > Settings > n8n API > Create an API key. Give it only the scopes listed in README.md.
N8N_API_KEY=
# The n8n project that holds the agents (Dan's agent department)
N8N_PROJECT_ID=72W9ojzaUG20j7lu

# Sign-in (Google). Create an OAuth client in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google accounts allowed in. Nobody else can sign in.
ALLOWED_EMAILS=
# Random 32+ character string: openssl rand -base64 32
NEXTAUTH_SECRET=
# The app's own URL, e.g. https://agents.example.com
NEXTAUTH_URL=

# Local only: 1 = skip sign-in and show the built-in snapshot instead of live n8n.
# Ignored on Vercel, so a deployed app can never run without sign-in.
PREVIEW_MODE=
